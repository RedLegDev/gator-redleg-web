{
  // Slim config for D1 migrations / secret ops only.
  // Deploy source of truth is cloudflare.config.ts (`npx @vinext/cloudflare deploy`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gator-redleg-web",
  "account_id": "ab1da25c524f59bc61f776304bd88558",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gator-board",
      "database_id": "ff4b4f12-7552-40f4-a6fe-596a12fe0b75"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "gator-board-attachments"
    }
  ]
}
