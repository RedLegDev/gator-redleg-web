{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gator-redleg-web",
  // Red Leg Dev account — where gatorredleg.org and its Email Sending live.
  "account_id": "ab1da25c524f59bc61f776304bd88558",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "gatorredleg.org", "custom_domain": true },
    { "pattern": "www.gatorredleg.org", "custom_domain": true }
  ],
  // Board hub — messages, tasks, magic-link auth. Apply with:
  //   npx wrangler d1 migrations apply gator-board --local|--remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gator-board",
      "database_id": "ff4b4f12-7552-40f4-a6fe-596a12fe0b75"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "gator-board-attachments"
    }
  ],
  // Cloudflare Email Sending — gatorredleg.org is onboarded in the Red Leg Dev
  // account. `remote: true` proxies sends to the real service during local dev.
  "send_email": [{ "name": "SEND_EMAIL", "remote": true }],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
