{
  "name": "gator-redleg-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:worker": "npm run cf-typegen && opennextjs-cloudflare build",
    "preview:worker": "opennextjs-cloudflare preview",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts && node scripts/patch-cf-types.mjs",
    "db:migrate:local": "wrangler d1 migrations apply gator-board --local",
    "db:migrate:remote": "wrangler d1 migrations apply gator-board --remote",
    "board:import": "node scripts/board-import.mjs",
    "email:test": "node scripts/test-inbound-email.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "15.5.20",
    "postal-mime": "^3.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "^1.20.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "raw-loader": "^4.0.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.110.0"
  }
}
